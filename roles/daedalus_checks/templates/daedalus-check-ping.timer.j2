# {{ ansible_managed }}
[Unit]
Description=Daedalus: database ping every {{ daedalus_checks_ping_every }}

[Timer]
# OnActiveSec starts the chain right after the timer is enabled; OnUnitActiveSec alone waits for a first run forever
OnActiveSec=30s
OnBootSec=1min
OnUnitActiveSec={{ daedalus_checks_ping_every }}

[Install]
WantedBy=timers.target
