# {{ ansible_managed }}
# Based on the unit file from the official k3s install script.
[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
# k3s tells systemd when it is ready
Type=notify
EnvironmentFile=-/etc/default/%N
# Kill only the k3s process on restart; pods keep running
KillMode=process
# k3s manages cgroups for its containers
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
# Kernel modules for pod networking and container filesystem ("-" = don't fail if already loaded)
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server
