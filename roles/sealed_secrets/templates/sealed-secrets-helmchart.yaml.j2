# {{ ansible_managed }}
# Installed by the k3s built-in helm-controller.
# The project moved from bitnami-labs to bitnami in 2026: use the new chart repo.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: sealed-secrets
  namespace: kube-system
spec:
  repo: https://bitnami.github.io/sealed-secrets
  chart: sealed-secrets
  version: "{{ sealed_secrets_chart_version }}"
  targetNamespace: kube-system
  valuesContent: |-
{{ sealed_secrets_values | to_nice_yaml(indent=2) | indent(4, true) }}
