# {{ ansible_managed }}
# Our own sealing key. The label makes the controller use it as the active key.
apiVersion: v1
kind: Secret
type: kubernetes.io/tls
metadata:
  name: sealed-secrets-key
  namespace: kube-system
  labels:
    sealedsecrets.bitnami.com/sealed-secrets-key: active
data:
  tls.crt: {{ lookup('ansible.builtin.file', sealed_secrets_cert_file) | b64encode }}
  tls.key: {{ lookup('ansible.builtin.file', sealed_secrets_key_file) | b64encode }}
